<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_template_form_inherit_halal_bpom" model="ir.ui.view">
            <field name="name">product.template.form.inherit.halal.bpom</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="🇮🇩 Halal &amp; BPOM RI">
                        <group>
                            <group string="Sertifikasi Halal BPJPH Kemenag">
                                <field name="is_halal_certified"/>
                                <field name="halal_certificate_id" invisible="not is_halal_certified"/>
                                <field name="halal_cert_number" invisible="not is_halal_certified"/>
                                <field name="halal_critical_level"/>
                            </group>
                            <group string="Izin Edar BPOM RI / P-IRT">
                                <field name="requires_bpom"/>
                                <field name="bpom_category" invisible="not requires_bpom"/>
                                <field name="bpom_nie" invisible="not requires_bpom" placeholder="misal: MD 268831001001"/>
                                <field name="bpom_nie_expiry" invisible="not requires_bpom"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
